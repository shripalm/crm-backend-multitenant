# Application
PROJECT_NAME=fastapi-app
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=80
STAGE_PATH=

# Database URLs (must include database name)
DB_URLS={"default":"postgresql+asyncpg://postgres:nopass@localhost:5432","test_db":"postgresql+asyncpg://postgres:nopass@localhost:5432/test_db","test_admin":"postgresql+asyncpg://postgres:nopass@localhost:5432/test_admin"}

# Database Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=3600

# Security
SECRET_KEY=smosby
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging
LOG_LVL=DEBUG
